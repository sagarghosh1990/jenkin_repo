pipeline {
    agent any
    environment {
        PYTHON = 'C:\\Users\\MONY SAGAR GHOSH\\AppDataLocal\\Programs\\Python\\Python314\\python.exe'
    }

    stages {
        stage("checkout code") {
            steps{
                checkput scm
            }
            
        }
        stage('show python version') {
            steps {
                bat "${env.PYTHON} --version"
            }
        }
        stage('run extract_data.py') {
            steps {
                bat "${env.PYTHON} extract_data.py"
            }
        }
    }
}